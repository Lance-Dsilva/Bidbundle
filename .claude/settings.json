{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run typecheck)",
      "Bash(npx vitest run:*)",
      "Bash(npx next build)",
      "Bash(bash scripts/preflight.sh)",
      "Bash(git status)",
