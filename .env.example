# Bundleen environment variables — NAMES ONLY.
#
# This file is committed. Never put a real value in it. Copy it to `.env.local`
# (git-ignored) and fill that in, or run `vercel env pull .env.local` to have
# Vercel write the development values for you.

# ── Clerk managed authentication ──
# Copy development values from the bundleen-auth Clerk resource into
# `.env.local`. Vercel supplies the production/preview values through the
# connected Marketplace integration.
# Safe to expose to the browser; identifies the Clerk application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only. Never prefix this with NEXT_PUBLIC_ and never commit its value.
CLERK_SECRET_KEY=
# Bundleen-owned pages used by Clerk when a session needs user interaction.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/get-started
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/continue
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/get-started/profile

# ── Postgres (Vercel Storage > Create Database) ──
# Pooled connection used by the running application.
DATABASE_URL=
# Direct (non-pooled) connection used by `prisma migrate`. Poolers cannot run
# the advisory locks migrations need. Leave empty if the provider offers only
# one URL — prisma.config.ts then falls back to DATABASE_URL.
DIRECT_URL=

# ── Vercel Blob (Vercel Storage > Create > Blob) ──
# Required for profile photo uploads. Create the store in the Vercel dashboard
# and connect it to this project; Vercel writes the token into the project's
# environment, then `vercel env pull .env.local` brings it here.
# Server-only. Must never be read from a Client Component. Without it,
# POST /api/profile/avatar answers 503 and the rest of the profile still works.
BLOB_READ_WRITE_TOKEN=

# ── Upstash Redis (Vercel Storage > Create Database) ──
# Required for Bundleen API rate limits. Clerk protects its managed sign-in
# endpoints; these credentials protect Bundleen-owned mutation endpoints.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Some Vercel Upstash integrations use these legacy Vercel KV aliases instead.
# Either this complete pair or the UPSTASH_REDIS_REST_* pair above is enough.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Random server-only salt used to pseudonymize IP-based limiter keys.
RATE_LIMIT_IDENTIFIER_SECRET=
