{
  "name": "bundleen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typecheck": "tsc --noEmit --incremental false",
    "qstash:configure-reminders": "node scripts/configure-qstash-reminders.mjs",
    "seed:demo-communities": "prisma db execute --file prisma/demo-communities.sql",
    "seed:demo-hoa": "prisma db execute --file prisma/demo-hoa.sql",
    "postinstall": "prisma generate",
    "build:check": "next build",
    "lint": "eslint --config eslint.checks.config.mjs ."
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@upstash/qstash": "^2.11.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/blob": "^2.7.0",
    "clsx": "2.1.1",
    "leaflet": "^1.9.4",
    "next": "15.5.22",
    "openai": "^7.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.3",
    "tailwind-merge": "2.5.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.12.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.22",
    "jsdom": "^29.1.1",
    "postcss": "8.5.25",
    "prisma": "^7.9.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "$postcss",
    "sharp": "$sharp"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "npm": ">=10 <12"
  }
}
