{
  "name": "bundleen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typecheck": "tsc --noEmit --incremental false",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/blob": "^2.7.0",
    "clsx": "2.1.1",
    "leaflet": "^1.9.4",
    "next": "15.5.22",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.3",
    "tailwind-merge": "2.5.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "dotenv": "^17.4.2",
    "postcss": "8.5.25",
    "prisma": "^7.9.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
