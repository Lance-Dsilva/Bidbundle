// Bundleen application profiles. Clerk is the identity and session system;
// this database stores only Bundleen-owned profile and authorization data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Global account role. `admin` is Bundleen staff and is deliberately absent
/// from `PUBLIC_ROLES`, so it cannot be reached through public sign-up.
/// Community responsibilities are NOT roles here — see `CommunityStaffRole`.
enum UserRole {
  homeowner
  provider
  admin
}

/// Portal access is an explicit allow-list in addition to the global User
/// role. The owner is the immutable bootstrap account; ordinary admins can be
/// granted and revoked only by that owner.
enum AdminAccessLevel {
  owner
  admin
}

enum AdminAccessStatus {
  pending
  active
  revoked
}

/// `hoa` represents an existing homeowners association. `neighborhood` is the
/// location-based grouping used for homeowners who belong to no HOA.
enum CommunityType {
  hoa
  neighborhood
}

enum CommunityStatus {
  active
  archived
}

/// Homeowner residency in a community. Membership is not permission.
enum MembershipStatus {
  pending
  active
  removed
}

/// Scoped operational access, granted only by Bundleen staff.
enum CommunityStaffRole {
  neighborhood_manager
  hoa_manager
  hoa_team
}

enum StaffAssignmentStatus {
  active
  revoked
}

/// Whether a provider account may take part in the marketplace. Suspension
/// blocks provider-only mutations; it never deletes bid or job history.
enum ProviderAccountStatus {
  pending
  active
  suspended
}

enum AdminAuditAction {
  community_created
  community_updated
  community_archived
  community_restored
  member_added
  member_status_changed
  member_removed
  staff_assigned
  staff_revoked
  provider_status_changed
  provider_license_verified
  provider_license_revoked
  provider_insurance_verified
  provider_insurance_revoked
  admin_access_granted
  admin_access_revoked
  community_invitation_sent
  community_invitation_accepted
  community_invitation_revoked
  hoa_request_created
  hoa_request_status_changed
  hoa_survey_created
  hoa_survey_status_changed
  hoa_profile_updated
  hoa_unit_created
  hoa_unit_updated
  hoa_units_imported
  hoa_participants_locked
  hoa_bid_awarded
  hoa_schedule_published
  hoa_visit_corrected
  address_verified
  address_verification_failed
  marketplace_recovery_action
  review_moderated
  provider_service_area_changed
  support_ticket_assigned
  support_ticket_status_changed
  support_ticket_priority_changed
  support_ticket_replied
  support_ticket_ai_draft_approved
  broadcast_created
  broadcast_updated
  broadcast_test_sent
  broadcast_sent
  broadcast_discarded
  admin_permissions_changed
  amenity_created
  amenity_updated
  amenity_published
  amenity_archived
  amenity_closure_changed
  amenity_booking_status_changed
  amenity_issue_status_changed
  amenity_issue_assigned
  amenity_review_moderated
  amenity_broadcast_sent
  amenity_media_removed
}

enum AdminAuditTargetType {
  community
  membership
  staff_assignment
  provider
  admin_access
  community_invitation
  hoa_request
  hoa_survey
  hoa_profile
  hoa_unit
  service_bid
  service_agreement
  service_visit
  review
  provider_service_area
  support_ticket
  broadcast
  amenity
  amenity_booking
  amenity_issue
  amenity_review
  media_asset
}

enum CommunityInvitationRole {
  hoa_manager
  homeowner
}

enum CommunityInvitationStatus {
  pending
  accepted
  revoked
}

enum HoaRequestKind {
  compulsory_recurring
  optional_group
}

/// Server-enforced request lifecycle. Compulsory recurring requests move
/// `draft -> open_for_bids`; optional requests pass through
/// `collecting_interest` and lock their participants before bids open.
enum HoaRequestStatus {
  draft
  collecting_interest
  open_for_bids
  bidding_closed
  awarded
  scheduled
  in_progress
  completed
  cancelled
  failed
}

/// HOA onboarding progress, owned by the Bundleen admin portal.
enum HoaOnboardingStatus {
  draft
  manager_invited
  manager_active
  residents_inviting
  live
  archived
}

enum UnitOccupancyStatus {
  vacant
  invite_pending
  occupied
  inactive
}

/// A resident's explicit answer to an optional request while enrollment is
/// open, or the server's audience snapshot for a compulsory request.
enum ParticipationResponse {
  joined
  declined
}

enum ServiceBidStatus {
  draft
  submitted
  withdrawn
  accepted
  rejected
  expired
}

enum BidPricingBasis {
  total
  per_home
  per_visit
}

enum ServiceAgreementStatus {
  active
  completed
  cancelled
}

enum ServiceOccurrenceStatus {
  planned
  in_progress
  completed
  cancelled
}

enum ServiceVisitStatus {
  unscheduled
  scheduled
  en_route
  in_progress
  completed
  skipped
  blocked
  cancelled
}

enum ReviewStatus {
  published
  removed
}

enum ProviderServiceAreaStatus {
  active
  removed
}

/// Server-owned outcome of the last forward-geocode of a stored postal
/// address. Admins never type coordinates; they read this instead.
///
/// - `pending`        — saved, not yet resolved (or a re-geocode is queued).
/// - `verified`       — one confident result; coordinates are current.
/// - `needs_correction` — the provider could not resolve it confidently, or
///                        returned only ambiguous candidates. Coordinates, if
///                        any, are stale and must not be trusted for routing.
enum AddressVerificationStatus {
  pending
  verified
  needs_correction
}

enum NotificationKind {
  invitation
  survey
  request
  bid
  award
  schedule
  visit
  review
  account
  security
  reminder
  /// HOA amenity reservations: requested, approved, declined, cancelled.
  booking
  /// HOA amenity issue tickets: acknowledged, replied, resolved.
  issue
}

enum OutboxStatus {
  pending
  delivered
  failed
}

enum HoaSurveyStatus {
  draft
  open
  closed
}

enum Weekday {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

/// Display-only payout state. Bundleen stores no bank credentials; when a
/// payment provider is added it will own the account and write this status
/// back through a server-side webhook.
enum PayoutStatus {
  not_connected
  pending
  active
  restricted
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  fullName    String
  phone       String?
  role        UserRole @default(homeowner)

  /// Server-controlled. Set from Clerk's email verification, never from a
  /// profile update body.
  isVerified Boolean @default(false)

  // ── Location ──────────────────────────────────────────────────────────
  // Supplied by the browser during onboarding and editable afterwards. These
  // are a matching hint, not proof of residence.
  address      String?
  neighborhood String?
  latitude     Float?
  longitude    Float?

  // ── Avatar ────────────────────────────────────────────────────────────
  // Only Blob metadata lives here. `avatarPath` is the pathname the delete and
  // replace flows need; the token that authorises those calls stays on the
  // server.
  avatarUrl       String?
  avatarPath      String?
  avatarUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeownerProfile HomeownerProfile?
  providerProfile  ProviderProfile?

  // ── Community ─────────────────────────────────────────────────────────
  // Residency and operational access are scoped rows, never booleans on the
  // account: "manager" is only ever true *of a particular community*.
  communityMemberships         CommunityMembership[]
  staffAssignments             CommunityStaffAssignment[]  @relation("StaffMember")
  staffAssignmentsMade         CommunityStaffAssignment[]  @relation("StaffAssigner")
  communityInvitationsSent     CommunityInvitation[]       @relation("CommunityInvitationSender")
  communityInvitationsAccepted CommunityInvitation[]       @relation("CommunityInvitationAcceptor")
  hoaRequestsCreated           HoaServiceRequest[]         @relation("HoaRequestCreator")
  hoaRequestParticipations     HoaRequestParticipation[]
  hoaSurveysCreated            HoaSurvey[]                 @relation("HoaSurveyCreator")
  hoaSurveyVotes               HoaSurveyVote[]
  providerApprovals            ProviderCommunityApproval[]
  auditLogEntries              AdminAuditLog[]             @relation("AuditActor")
  providerServiceAreas         ProviderServiceArea[]
  serviceBids                  ServiceBid[]                @relation("BidProvider")
  serviceVisitsAsHomeowner     ServiceVisit[]              @relation("VisitHomeowner")
  serviceAgreementsWon         ServiceAgreement[]          @relation("AgreementProvider")
  serviceAgreementsAwarded     ServiceAgreement[]          @relation("AgreementAwarder")
  reviewsWritten               Review[]                    @relation("ReviewAuthor")
  reviewsReceived              Review[]                    @relation("ReviewProvider")
  notifications                Notification[]

  adminAccess        AdminAccessGrant?  @relation("AdminAccessUser")
  adminAccessGranted AdminAccessGrant[] @relation("AdminAccessGrantor")
  adminAccessRevoked AdminAccessGrant[] @relation("AdminAccessRevoker")

  aiConversations AiConversation[]
  aiUsageLogs     AiUsageLog[]

  // ── Support ───────────────────────────────────────────────────────────
  supportTicketsRaised    SupportTicket[]        @relation("SupportTicketRequester")
  supportTicketsAssigned  SupportTicket[]        @relation("SupportTicketAssignee")
  supportTicketMessages   SupportTicketMessage[] @relation("SupportTicketMessageAuthor")
  supportTicketEvents     SupportTicketEvent[]   @relation("SupportTicketEventActor")
  supportAiDraftsCreated  SupportTicketAiDraft[] @relation("SupportTicketAiDraftAuthor")
  supportAiDraftsApproved SupportTicketAiDraft[] @relation("SupportTicketAiDraftApprover")

  // ── Communications ────────────────────────────────────────────────────
  broadcastsCreated   Broadcast[]          @relation("BroadcastAuthor")
  broadcastsApproved  Broadcast[]          @relation("BroadcastApprover")
  broadcastDeliveries BroadcastRecipient[] @relation("BroadcastRecipientUser")

  // ── HOA amenities ─────────────────────────────────────────────────────
  amenitiesCreated         Amenity[]               @relation("AmenityCreator")
  amenityClosuresCreated   AmenityClosure[]        @relation("AmenityClosureCreator")
  amenityBookings          AmenityBooking[]        @relation("AmenityBookingResident")
  amenityBookingsApproved  AmenityBooking[]        @relation("AmenityBookingApprover")
  amenityBookingsCancelled AmenityBooking[]        @relation("AmenityBookingCanceller")
  amenityBookingEvents     AmenityBookingEvent[]   @relation("AmenityBookingEventActor")
  amenityIssuesReported    AmenityIssue[]          @relation("AmenityIssueReporter")
  amenityIssuesAssigned    AmenityIssue[]          @relation("AmenityIssueAssignee")
  amenityIssueMessages     AmenityIssueMessage[]   @relation("AmenityIssueMessageAuthor")
  amenityIssueEvents       AmenityIssueEvent[]     @relation("AmenityIssueEventActor")
  amenityReviewsWritten    AmenityReview[]         @relation("AmenityReviewAuthor")
  amenityReviewsModerated  AmenityReview[]         @relation("AmenityReviewModerator")
  amenityReviewResponses   AmenityReviewResponse[] @relation("AmenityReviewResponder")
  mediaUploaded            MediaAsset[]            @relation("MediaUploader")
}

/// Email allow-list for the private Bundleen operations portal.
///
/// A pending row is safe: it has no power until a Clerk identity proves the
/// exact email address. The owner row is created by the migration and cannot
/// be revoked by the application or by a direct database update.
model AdminAccessGrant {
  id     String            @id @default(cuid())
  email  String            @unique
  level  AdminAccessLevel  @default(admin)
  status AdminAccessStatus @default(pending)

  userId String? @unique
  user   User?   @relation("AdminAccessUser", fields: [userId], references: [id], onDelete: SetNull)

  /// Extra capabilities beyond ordinary portal access, granted one at a time by
  /// the owner. Deliberately additive and empty by default: holding `admin`
  /// must never imply the power to email every customer. The owner needs no
  /// entry here — `owner` implies every permission.
  ///
  /// Values come from the closed `ADMIN_PERMISSIONS` list in
  /// `lib/admin-permissions.ts`; an unrecognized string grants nothing.
  permissions String[] @default([])

  previousRole UserRole?

  clerkInvitationId String? @unique

  grantedByUserId String?
  grantedBy       User?     @relation("AdminAccessGrantor", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  grantedAt       DateTime  @default(now())
  acceptedAt      DateTime?

  revokedByUserId String?
  revokedBy       User?     @relation("AdminAccessRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  revokedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, email])
}

/// A group of homeowners: either a real HOA or a radius around a point.
///
/// `centerLatitude`, `centerLongitude`, and `radiusMiles` are nullable at the
/// column level because an HOA does not need them, and required for a
/// `neighborhood` by a CHECK constraint in the migration — Prisma cannot
/// express a conditional requirement.
model Community {
  id     String          @id @default(cuid())
  name   String
  type   CommunityType
  status CommunityStatus @default(active)

  centerLatitude  Float?
  centerLongitude Float?

  /// Admin-owned, never client-owned. Homeowners have no radius control
  /// anywhere in the product; only Bundleen staff set this, and new
  /// neighborhoods default to the standard community radius.
  radiusMiles Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       CommunityMembership[]
  staffAssignments  CommunityStaffAssignment[]
  invitations       CommunityInvitation[]
  hoaRequests       HoaServiceRequest[]
  hoaSurveys        HoaSurvey[]
  providerApprovals ProviderCommunityApproval[]
  auditLogEntries   AdminAuditLog[]
  hoaProfile        HoaProfile?
  units             CommunityUnit[]
  serviceAgreements ServiceAgreement[]
  supportTickets    SupportTicket[]

  // ── HOA amenities (never populated for a `neighborhood` community) ─────
  amenities       Amenity[]
  amenityBookings AmenityBooking[]
  amenityIssues   AmenityIssue[]
  amenityReviews  AmenityReview[]
  mediaAssets     MediaAsset[]

  @@index([type, status])
  @@index([status, name])
}

/// Legal and onboarding detail for one official HOA. Exactly one row per
/// `hoa`-type community; a `neighborhood` community never has one.
model HoaProfile {
  id          String    @id @default(cuid())
  communityId String    @unique
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  legalName   String
  displayName String?

  addressLine1 String
  addressLine2 String?
  locality     String
  region       String
  postalCode   String
  country      String  @default("US")

  // ── Resolved location ─────────────────────────────────────────────────
  // Internal only. Admins enter a postal address; the server forward-geocodes
  // it through `lib/server/geocoding.ts` and writes these atomically with the
  // normalized address. No admin form or CSV column accepts a coordinate, and
  // no API response returns these to a customer or an unawarded provider.
  latitude  Float?
  longitude Float?

  /// The geocoder's own one-line rendering of the address it matched. Shown
  /// to the admin as "this is what we verified", in place of numbers.
  formattedAddress String?

  addressVerificationStatus AddressVerificationStatus @default(pending)
  addressVerifiedAt         DateTime?
  /// Provider place identifier, kept so a later re-check can be exact.
  geocodePlaceId            String?
  /// 0..1 provider confidence for the accepted result. Diagnostic only.
  geocodeConfidence         Float?

  /// IANA name such as `America/Chicago`. Occurrence dates are computed in it.
  timezone String @default("America/Chicago")

  /// Declared homes/units. Honest capacity, not the active homeowner count —
  /// the unit inventory represents vacant and uninvited homes.
  totalHomes Int

  referenceCode String?
  serviceNotes  String?

  onboardingStatus HoaOnboardingStatus @default(draft)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([onboardingStatus])
}

/// One home/unit in an HOA's inventory. The private service location: exact
/// coordinates and access notes are exposed only to the scoped manager, the
/// resident of this unit, Bundleen admins, and the awarded provider.
model CommunityUnit {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  /// Display label such as `Home 14`, `Unit 2B`, or `11804 Cedar Lane`.
  label String

  // Null address fields inherit the HOA's primary address — and, when they do,
  // the unit inherits the HOA's verified coordinates too rather than being
  // geocoded separately.
  addressLine1 String?
  locality     String?
  region       String?
  postalCode   String?
  latitude     Float?
  longitude    Float?

  /// Set only on units with their own distinct address. A unit inheriting the
  /// HOA address stays `pending` and is never sent to the geocoder.
  addressVerificationStatus AddressVerificationStatus @default(pending)
  addressVerifiedAt         DateTime?
  formattedAddress          String?
  geocodePlaceId            String?

  occupancyStatus UnitOccupancyStatus @default(vacant)

  /// Gate codes, pet warnings, etc. Strictly authorized; never audited.
  accessNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     CommunityMembership[]
  invitations     CommunityInvitation[]
  participations  HoaRequestParticipation[]
  visits          ServiceVisit[]
  amenityBookings AmenityBooking[]

  @@unique([communityId, label])
  @@index([communityId, occupancyStatus])
  @@index([communityId, addressVerificationStatus])
}

/// Homeowner residency in a community.
///
/// Holding this row says nothing about what the user may manage — that is
/// {@link CommunityStaffAssignment}. Only accounts whose global role is
/// `homeowner` are accepted, which the service layer enforces.
model CommunityMembership {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  status MembershipStatus @default(active)

  /// Set when the membership first became `active`, so a removal and re-add
  /// does not silently rewrite the resident's history.
  joinedAt DateTime?

  /// The home this resident actually lives in, when they belong to more than
  /// one community.
  isPrimary Boolean @default(false)

  /// True when a Bundleen admin placed this member by hand rather than the
  /// server matching them by radius. Kept so an override is visible on the
  /// record itself and not only in the audit log.
  isAdminOverride Boolean @default(false)

  /// Server-assigned capacity slot for a current, non-override neighborhood
  /// placement. A partial unique index and trigger allocate slots 1..50; HOA
  /// and explicit admin-override memberships keep this null.
  neighborhoodSlot Int?

  /// The HOA home this resident occupies. Required for `hoa` memberships and
  /// always null for `neighborhood` ones (trigger-enforced). A partial unique
  /// index allows one active primary homeowner per unit.
  unitId String?
  unit   CommunityUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([communityId, userId])
  @@index([userId, status])
  @@index([communityId, status])
  @@index([unitId, status])
}

/// Scoped operational access to one community.
///
/// Two rules cannot be written in Prisma and live as partial unique indexes in
/// the migration instead: at most one *active* assignment per
/// community/user/role, and at most one *active* `neighborhood_manager` per
/// community.
model CommunityStaffAssignment {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("StaffMember", fields: [userId], references: [id], onDelete: Cascade)

  role   CommunityStaffRole
  status StaffAssignmentStatus @default(active)

  /// The Bundleen admin who granted this. Nobody can be their own assigner —
  /// the service layer rejects self-assignment.
  assignedByUserId String?
  assignedBy       User?    @relation("StaffAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  assignedAt       DateTime @default(now())

  revokedAt       DateTime?
  /// Plain column rather than a relation: the audit log already holds the
  /// foreign-keyed record of who acted, and a third `User` back-relation here
  /// would exist only to be ignored.
  revokedByUserId String?

  @@index([userId, status])
  @@index([communityId, status])
}

/// An email-bound invitation to one HOA. The invitation has no authority by
/// itself: acceptance requires Clerk to prove the exact verified email, after
/// which the server creates either a resident membership or a scoped manager
/// assignment. Raw invitation tickets are owned by Clerk and never stored.
model CommunityInvitation {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  email  String
  role   CommunityInvitationRole
  status CommunityInvitationStatus @default(pending)

  /// The specific home a homeowner invitation is bound to. Required for
  /// homeowner invitations, null for manager invitations (trigger-enforced).
  unitId String?
  unit   CommunityUnit? @relation(fields: [unitId], references: [id], onDelete: Cascade)

  clerkInvitationId String? @unique

  invitedByUserId String
  invitedBy       User      @relation("CommunityInvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  invitedAt       DateTime  @default(now())
  expiresAt       DateTime?

  acceptedByUserId String?
  acceptedBy       User?     @relation("CommunityInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  acceptedAt       DateTime?
  revokedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([communityId, email, role])
  @@index([email, status])
  @@index([communityId, status])
}

/// A community service request owned by an HOA manager. Compulsory recurring
/// requests are visible to every active resident; optional group requests use
/// participation rows to record who chose to join.
model HoaServiceRequest {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  createdByUserId String
  createdBy       User   @relation("HoaRequestCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  title           String
  category        String
  description     String
  kind            HoaRequestKind
  recurrenceLabel String?
  status          HoaRequestStatus @default(draft)
  opensAt         DateTime?

  /// Optional requests: when resident enrollment closes.
  enrollmentClosesAt     DateTime?
  /// When provider bidding closes. Required before `open_for_bids`.
  biddingClosesAt        DateTime?
  /// Requested first service date for the winning provider.
  startDate              DateTime?
  /// Recurring cadence in days (e.g. 14 for biweekly). Null for one-off work.
  recurrenceIntervalDays Int?
  /// How many occurrences the agreement materializes. 1 for one-off work.
  totalOccurrences       Int       @default(1)

  /// Optional requests: minimum/maximum homes needed before an award.
  minHomes Int?
  maxHomes Int?

  /// The homeowner's budget range, in whole US cents — the same unit as
  /// `ServiceBid.amountCents`. Null on HOA-manager requests, which are quoted
  /// by providers rather than budgeted by a resident. A database CHECK keeps
  /// the pair all-or-nothing, non-negative, and correctly ordered.
  budgetMinCents Int?
  budgetMaxCents Int?

  /// Set when the participant set was snapshotted/locked so providers quote
  /// against a stable number of homes. Immutable afterwards.
  participantsLockedAt DateTime?
  awardedAt            DateTime?

  participations HoaRequestParticipation[]
  bids           ServiceBid[]
  agreement      ServiceAgreement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([communityId, status, createdAt])
  @@index([status, category, biddingClosesAt])
  @@index([createdByUserId, createdAt])
  @@index([status, biddingClosesAt])
  @@index([status, enrollmentClosesAt])
}

/// One unit's relationship to one request: a resident's explicit join/decline
/// for optional requests, or the server's audience snapshot for compulsory
/// requests (where `userId` may be null for vacant units).
model HoaRequestParticipation {
  id        String            @id @default(cuid())
  requestId String
  request   HoaServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId    String?
  unit      CommunityUnit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  response  ParticipationResponse @default(joined)
  joinedAt  DateTime              @default(now())
  updatedAt DateTime              @default(now()) @updatedAt

  @@unique([requestId, unitId])
  @@index([userId, joinedAt])
  @@index([requestId, response])
  @@index([userId, response])
}

/// Structured provider coverage: a center-plus-radius circle and/or a set of
/// postal codes. A provider with no active area is eligible nowhere.
///
/// The circle columns stay nullable because the original model also allowed a
/// postal-code-only area, and existing rows must keep working. Everything the
/// map editor writes supplies all three together — `providerServiceAreaSchema`
/// requires them — so a coverage circle is never half-defined.
model ProviderServiceArea {
  id             String @id @default(cuid())
  providerUserId String
  provider       User   @relation(fields: [providerUserId], references: [id], onDelete: Cascade)

  label String

  centerLatitude  Float?
  centerLongitude Float?
  radiusMiles     Float?

  postalCodes String[] @default([])

  /// The area onboarding created. A partial unique index in the migration
  /// allows at most one active primary area per provider.
  isPrimary Boolean @default(false)

  // ── Saved address context ─────────────────────────────────────────────
  // Enough of the geocoder's answer to redraw the provider's own selection
  // later without a second lookup, and to write the plain-language summary.
  // Private operational data: `serializeServiceArea` returns it only to the
  // owning provider, never to customers or another provider.
  formattedAddress String?
  locality         String?
  region           String?
  postalCode       String?
  countryCode      String?

  status ProviderServiceAreaStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerUserId, status])
}

/// One provider's current bid on one request. Revisions update the row and
/// increment `version` while bidding is open; a partial unique index allows at
/// most one accepted bid per request.
model ServiceBid {
  id        String            @id @default(cuid())
  requestId String
  request   HoaServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  providerUserId String
  provider       User   @relation("BidProvider", fields: [providerUserId], references: [id], onDelete: Cascade)

  status ServiceBidStatus @default(submitted)

  /// Money is always nonnegative integer cents.
  amountCents  Int
  currency     String          @default("usd")
  pricingBasis BidPricingBasis
  /// Per-home price in cents when the basis needs a breakdown.
  perHomeCents Int?

  proposedStartDate      DateTime?
  estimatedDurationLabel String?
  scope                  String
  exclusions             String?
  cadenceLabel           String?
  validUntil             DateTime?

  version     Int       @default(1)
  submittedAt DateTime  @default(now())
  withdrawnAt DateTime?
  decidedAt   DateTime?

  agreement ServiceAgreement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, providerUserId])
  @@index([providerUserId, status])
  @@index([requestId, status])
}

/// The accepted commercial terms, snapshotted at award time so later bid or
/// profile edits cannot rewrite what was agreed. One per request, atomically.
model ServiceAgreement {
  id        String            @id @default(cuid())
  requestId String            @unique
  request   HoaServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  bidId String     @unique
  bid   ServiceBid @relation(fields: [bidId], references: [id], onDelete: Restrict)

  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Restrict)

  providerUserId String
  provider       User   @relation("AgreementProvider", fields: [providerUserId], references: [id], onDelete: Restrict)

  awardedByUserId String?
  awardedBy       User?   @relation("AgreementAwarder", fields: [awardedByUserId], references: [id], onDelete: SetNull)

  // ── Snapshot of the accepted terms ────────────────────────────────────
  amountCents     Int
  currency        String          @default("usd")
  pricingBasis    BidPricingBasis
  perHomeCents    Int?
  scope           String
  exclusions      String?
  cadenceLabel    String?
  /// Number of participating homes locked at award time.
  lockedHomeCount Int

  startDate DateTime?
  endDate   DateTime?

  status ServiceAgreementStatus @default(active)

  occurrences ServiceOccurrence[]
  reviews     Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerUserId, status])
  @@index([communityId, status])
}

/// One recurring cycle (or the single date of a one-off service).
model ServiceOccurrence {
  id          String           @id @default(cuid())
  agreementId String
  agreement   ServiceAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  /// 1-based cycle number; unique per agreement so materialization retries
  /// cannot duplicate a cycle.
  sequence    Int
  serviceDate DateTime

  status   ServiceOccurrenceStatus @default(planned)
  closedAt DateTime?

  /// Set when the provider publishes the day plan for this occurrence.
  schedulePublishedAt DateTime?

  visits ServiceVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agreementId, sequence])
  @@index([agreementId, serviceDate])
}

/// One provider stop for one occurrence, at exactly one service target.
///
/// Two kinds of target share this table because they share the whole schedule,
/// completion, and review lifecycle:
///
/// - **HOA** — `unitId` points at a {@link CommunityUnit}. The unit inventory
///   owns the address; nothing is snapshotted, because the HOA's roster is the
///   record of what was serviced. This is the original, unchanged behavior.
/// - **Neighborhood** — `homeownerUserId` points at the participating
///   homeowner, and the `service*` columns hold an *immutable* copy of the
///   address and coordinates as they stood at award time.
///
/// A database CHECK (`ServiceVisit_one_target`) enforces exactly one of the
/// two, so no code path can create a stop with no service location or with
/// two conflicting ones. A second CHECK (`ServiceVisit_homeowner_snapshot`)
/// requires the snapshot whenever the target is a homeowner: a routeable stop
/// with no routeable address is not a valid row.
///
/// The snapshot is the reason a later profile edit cannot rewrite historical
/// work. The homeowner relation is retained for authorization — "is this my
/// stop?" — never re-read to resolve where the crew should go.
model ServiceVisit {
  id           String            @id @default(cuid())
  occurrenceId String
  occurrence   ServiceOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  unitId String?
  unit   CommunityUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)

  homeownerUserId String?
  homeowner       User?   @relation("VisitHomeowner", fields: [homeownerUserId], references: [id], onDelete: Restrict)

  // ── Immutable service-location snapshot (neighborhood targets) ────────
  /// Display label for the stop, e.g. `11804 Cedar Lane`.
  serviceLabel        String?
  serviceAddressLine1 String?
  serviceAddressLine2 String?
  serviceLocality     String?
  serviceRegion       String?
  servicePostalCode   String?
  serviceCountry      String?
  serviceLatitude     Float?
  serviceLongitude    Float?
  /// Gate codes, pet warnings. Awarded provider and resident only; never audited.
  serviceAccessNotes  String?

  /// Provider-chosen order of the day's stops. Authoritative once published.
  stopRank Int?

  scheduledDate    DateTime?
  windowStart      String?
  windowEnd        String?
  estimatedMinutes Int?

  status          ServiceVisitStatus @default(unscheduled)
  statusChangedAt DateTime?
  completionNote  String?
  completedAt     DateTime?

  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([occurrenceId, unitId])
  @@unique([occurrenceId, homeownerUserId])
  @@index([unitId, status])
  @@index([homeownerUserId, status])
  @@index([occurrenceId, stopRank])
  @@index([status, scheduledDate])
}

/// One homeowner review per completed visit, or one manager review per
/// completed agreement. Exactly one subject per row (CHECK-enforced).
model Review {
  id String @id @default(cuid())

  reviewerUserId String
  reviewer       User   @relation("ReviewAuthor", fields: [reviewerUserId], references: [id], onDelete: Cascade)

  providerUserId String
  provider       User   @relation("ReviewProvider", fields: [providerUserId], references: [id], onDelete: Cascade)

  visitId String?
  visit   ServiceVisit? @relation(fields: [visitId], references: [id], onDelete: Cascade)

  agreementId String?
  agreement   ServiceAgreement? @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  /// 1..5, server validated and CHECK-bounded.
  rating  Int
  comment String

  status ReviewStatus @default(published)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reviewerUserId, visitId])
  @@unique([reviewerUserId, agreementId])
  @@index([providerUserId, status, createdAt])
}

/// In-app notification record. `dedupeKey` makes creation idempotent so
/// retries and concurrent mutations cannot duplicate an intended event.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind     NotificationKind
  title    String
  body     String
  linkPath String?

  dedupeKey String @unique

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

/// Durable delivery queue. Database commits never depend on an email provider
/// call succeeding; a worker delivers pending events idempotently and retries.
model OutboxEvent {
  id String @id @default(cuid())

  kind      String
  dedupeKey String @unique

  /// Allow-listed payload only: ids and safe display fields, never resident
  /// addresses, coordinates, tokens, or access notes.
  payload Json

  status            OutboxStatus @default(pending)
  attempts          Int          @default(0)
  nextAttemptAt     DateTime     @default(now())
  lastError         String?
  deliveredAt       DateTime?
  /// Delivery provider's message id, for support. Never a secret.
  providerMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
}

/// One manager-authored resident survey for a calendar month. Options are
/// stored as a bounded ordered list; each active resident may select one.
model HoaSurvey {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  createdByUserId String
  createdBy       User   @relation("HoaSurveyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  monthKey String
  question String
  options  String[]
  status   HoaSurveyStatus @default(draft)
  closesAt DateTime?

  votes HoaSurveyVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([communityId, monthKey])
  @@index([communityId, status, createdAt])
}

model HoaSurveyVote {
  id          String    @id @default(cuid())
  surveyId    String
  survey      HoaSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionIndex Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([surveyId, userId])
  @@index([userId, createdAt])
}

/// Communities a provider is approved to serve.
///
/// Modelled now so the relationship has one shape when the job/bid flow needs
/// it. Nothing reads it yet, and no screen invents approvals to display.
model ProviderCommunityApproval {
  id             String    @id @default(cuid())
  communityId    String
  community      Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  providerUserId String
  provider       User      @relation(fields: [providerUserId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  createdByUserId String?

  @@unique([communityId, providerUserId])
  @@index([providerUserId])
}

/// Append-only record of every sensitive Bundleen staff action and narrowly
/// defined automatic safety event.
///
/// A trigger in the migration rejects UPDATE and DELETE, so the actor relation
/// is `Restrict` rather than `Cascade`: deleting an admin account must not be
/// able to erase what that account did.
model AdminAuditLog {
  id          String               @id @default(cuid())
  /// Null only for server-generated safety events such as automatically
  /// invalidating verification after a provider changes the underlying claim.
  actorUserId String?
  actor       User?                @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action      AdminAuditAction
  targetType  AdminAuditTargetType
  targetId    String

  communityId    String?
  community      Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  providerUserId String?

  /// Safe before/after summary only. Never secrets, never street addresses,
  /// never coordinates — see `redactAuditMetadata`.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([communityId, createdAt])
  @@index([providerUserId, createdAt])
  @@index([actorUserId, createdAt])
}

/// Homeowner-only profile data. Exactly one row per homeowner `User`.
model HomeownerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notifyBids    Boolean @default(true)
  notifyGroups  Boolean @default(true)
  notifySavings Boolean @default(false)
  notifyEmail   Boolean @default(true)
  notifyPush    Boolean @default(true)

  /// Fixed community radius. Stored so queries have a value to join against,
  /// but it is deliberately absent from every update schema — grouping by a
  /// uniform proximity is the product, so this is not a user setting.
  serviceRadiusMi Int @default(4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Provider-only profile data. Exactly one row per provider `User`.
model ProviderProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String?
  bio         String?
  trades      String[] @default([])

  /// See `HomeownerProfile.serviceRadiusMi` — same fixed radius, same reason.
  serviceRadiusMi Int @default(4)

  workingDays       Weekday[] @default([])
  /// `HH:MM`, 24-hour, in the provider's local time.
  workingHoursStart String?
  workingHoursEnd   String?

  // ── Credential claims (user-supplied) ─────────────────────────────────
  // What the provider says about their license and insurance. Displaying any
  // of this as "verified" requires the timestamps below, which they cannot
  // write.
  licenseNumber         String?
  licenseState          String?
  insuranceProvider     String?
  insurancePolicyNumber String?

  // ── Account status (server/admin controlled) ──────────────────────────
  // New providers start `pending`. Suspension blocks provider-only mutations
  // and new bidding; it never removes existing bids or jobs.
  accountStatus                ProviderAccountStatus @default(pending)
  accountStatusUpdatedAt       DateTime?
  /// Bundleen admin who last changed the status. A plain column, not a
  /// relation — `AdminAuditLog` holds the foreign-keyed history.
  accountStatusUpdatedByUserId String?
  /// Internal note on the last status change. Never shown to the provider.
  accountStatusNote            String?

  // ── Verification (server/admin controlled) ────────────────────────────
  // Timestamps are written only by an admin endpoint. Editing the matching
  // claim above clears them again (`providerProfileUpdateData`).
  licenseVerifiedAt         DateTime?
  licenseVerifiedByUserId   String?
  insuranceVerifiedAt       DateTime?
  insuranceVerifiedByUserId String?

  // ── Payout display metadata (server controlled) ───────────────────────
  // No account or routing number is ever accepted or stored. `payoutLast4` is
  // whatever a future payment provider reports back for display.
  payoutStatus    PayoutStatus @default(not_connected)
  payoutLast4     String?
  payoutProvider  String?
  payoutUpdatedAt DateTime?

  notifyNewJobs  Boolean @default(true)
  notifyMessages Boolean @default(true)
  notifyPayouts  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountStatus])
}

/**
 * ── Customer support ─────────────────────────────────────────────────────
 */

/// Where a ticket sits in the queue. `new` is "nobody has looked yet";
/// `pending_customer` stops the SLA clock because Bundleen is not the blocker.
enum SupportTicketStatus {
  new
  open
  pending_customer
  pending_internal
  resolved
  closed
}

enum SupportTicketPriority {
  low
  normal
  high
  urgent
}

enum SupportTicketCategory {
  account
  billing
  service_request
  bidding
  scheduling
  provider_issue
  community
  technical
  other
}

/// `internal_note` is never returned by a customer-facing API or included in an
/// email — see `customerVisibleMessages` in `lib/server/support.ts`.
enum SupportTicketMessageKind {
  customer_reply
  admin_reply
  internal_note
}

enum SupportTicketEventType {
  created
  status_changed
  priority_changed
  assigned
  unassigned
  customer_replied
  admin_replied
  internal_note_added
  reopened
  ai_draft_generated
  ai_draft_approved
  ai_draft_discarded
  ai_explanation_generated
}

enum SupportTicketAiDraftKind {
  reply
  explanation
}

/// A draft is inert until an admin approves it. `approved` is only ever set by
/// the endpoint that also creates the outgoing message, in the same
/// transaction, so an approved draft always corresponds to text a human sent.
enum SupportTicketAiDraftStatus {
  generated
  discarded
  approved
}

/// One customer support conversation.
///
/// `ticketNumber` is the immutable human-facing identity (quoted in email and
/// read out on a call); `id` is what every relation uses, so renaming schemes
/// later cannot break foreign keys.
model SupportTicket {
  id           String @id @default(cuid())
  ticketNumber String @unique

  requesterUserId String
  requester       User     @relation("SupportTicketRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  /// The requester's global role at creation time, kept so the queue can still
  /// filter by "provider tickets" after an account changes role.
  requesterRole   UserRole

  /// Set when the ticket is about a specific community. `SetNull` rather than
  /// cascade: support history must outlive an archived community.
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  subject  String
  category SupportTicketCategory
  status   SupportTicketStatus   @default(new)
  priority SupportTicketPriority @default(normal)

  /// Plain ids, not relations: they point at optional context records whose
  /// deletion must never cascade into support history, and nothing joins on
  /// them in a hot path.
  relatedRequestId String?
  relatedBidId     String?
  relatedVisitId   String?

  /// The admin currently responsible. `SetNull` keeps the ticket when an admin
  /// account is removed — the audit log holds who did what.
  assignedAdminUserId String?
  assignedAdmin       User?   @relation("SupportTicketAssignee", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)

  /// SLA timestamps. `firstAdminReplyAt` is write-once.
  firstAdminReplyAt     DateTime?
  lastCustomerMessageAt DateTime?
  lastAdminMessageAt    DateTime?
  lastActivityAt        DateTime  @default(now())

  resolvedAt DateTime?
  closedAt   DateTime?

  /// A follow-up created from a ticket that could no longer be reopened.
  reopenedFromTicketId String?

  messages SupportTicketMessage[]
  events   SupportTicketEvent[]
  aiDrafts SupportTicketAiDraft[]

  createdAt DateTime @default(now())
  /// Also the optimistic-concurrency token: admin mutations pass the value they
  /// read, and a stale write matches no row (P2025) instead of silently
  /// overwriting a colleague's reply.
  updatedAt DateTime @updatedAt

  @@index([status, priority, lastActivityAt])
  @@index([requesterUserId, createdAt])
  @@index([assignedAdminUserId, status])
  @@index([communityId, createdAt])
  @@index([category, status])
}

/// One entry in the ticket conversation.
///
/// `body` is stored and rendered as plain text. Nothing in this table is ever
/// treated as markup, so a customer cannot inject HTML into an admin's screen
/// or into an outgoing email.
model SupportTicketMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// Null only for a system-authored line. `SetNull` so a deleted account does
  /// not erase the conversation the other party still needs.
  authorUserId String?
  author       User?   @relation("SupportTicketMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  kind SupportTicketMessageKind
  body String

  /// Set when this message was sent from an approved AI draft. Audit metadata
  /// only — the text in `body` is what the admin actually approved.
  fromAiDraftId String?

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Append-only activity timeline: assignment, status, priority, replies.
model SupportTicketEvent {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  actorUserId String?
  actor       User?   @relation("SupportTicketEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  type      SupportTicketEventType
  fromValue String?
  toValue   String?

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// An AI-prepared customer reply or internal explanation.
///
/// Deliberately holds only the final generated text — never hidden reasoning,
/// never raw tool arguments or results — matching the principle already applied
/// to `AiMessage` and `AiUsageLog`.
model SupportTicketAiDraft {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  kind   SupportTicketAiDraftKind
  status SupportTicketAiDraftStatus @default(generated)

  generatedByAdminUserId String
  generatedByAdmin       User   @relation("SupportTicketAiDraftAuthor", fields: [generatedByAdminUserId], references: [id], onDelete: Cascade)

  /// The model's output. For `explanation` this is internal-only forever and is
  /// excluded from every customer-facing serializer.
  content String
  model   String

  /// Which retrieval tools ran, for audit. Names only, never their arguments.
  toolNames String[] @default([])

  /// Set together when an admin approves a `reply` draft. `sentText` is the
  /// exact text that went out, which may differ from `content` after editing.
  approvedByAdminUserId String?
  approvedByAdmin       User?     @relation("SupportTicketAiDraftApprover", fields: [approvedByAdminUserId], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  sentText              String?
  sentMessageId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, kind, createdAt])
}

/**
 * ── Operational broadcasts ───────────────────────────────────────────────
 */

/// How serious the message is. Only the three operational classes may override
/// a recipient's general email preference, and only with explicit admin
/// confirmation — see `broadcastBypassesPreference`.
enum BroadcastSeverity {
  announcement
  maintenance
  degraded
  outage
  security
}

enum BroadcastStatus {
  draft
  queued
  processing
  completed
  failed
  cancelled
}

enum BroadcastRecipientStatus {
  pending
  sent
  failed
  suppressed
}

/// One platform-wide operational message.
///
/// Sending is a two-phase action: a draft is composed and previewed, then a
/// separate authorized call materializes recipients and enqueues delivery.
/// Nothing here sends mail inline — `BroadcastRecipient` rows feed the existing
/// `OutboxEvent` queue.
model Broadcast {
  id String @id @default(cuid())

  subject  String
  body     String
  severity BroadcastSeverity @default(announcement)
  status   BroadcastStatus   @default(draft)

  /// Optional in-app copy. Absent means email only.
  inAppTitle String?
  inAppBody  String?
  linkPath   String?

  /// Empty means every active account. Otherwise a subset of
  /// `homeowner`/`hoa_manager`/`provider`, resolved server-side.
  audienceSegments String[] @default([])

  /// True only for a clearly classified urgent operational/security message
  /// that the sending admin explicitly confirmed may reach accounts which have
  /// turned general announcement email off. Always audited.
  overridesEmailPreference Boolean @default(false)

  createdByUserId String
  createdBy       User   @relation("BroadcastAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  approvedByUserId String?
  approvedBy       User?     @relation("BroadcastApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?

  /// Server-calculated at send time, not a client-supplied estimate.
  recipientCount Int @default(0)

  queuedAt    DateTime?
  completedAt DateTime?

  recipients BroadcastRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([severity, createdAt])
}

/// One intended delivery. The `(broadcastId, userId)` and
/// `(broadcastId, email)` unique constraints are what make a retry idempotent:
/// re-running send cannot create a second row, so it cannot create a second
/// email.
model BroadcastRecipient {
  id          String    @id @default(cuid())
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("BroadcastRecipientUser", fields: [userId], references: [id], onDelete: Cascade)

  email String

  status           BroadcastRecipientStatus @default(pending)
  /// Coarse reason a recipient was skipped (`preference_opt_out`,
  /// `invalid_email`). Never a provider error body.
  suppressedReason String?

  sentAt DateTime?

  createdAt DateTime @default(now())

  @@unique([broadcastId, userId])
  @@unique([broadcastId, email])
  @@index([broadcastId, status])
}

/**
 * ── Bundleen AI assistant ────────────────────────────────────────────────
 */

enum AiMessageRole {
  user
  assistant
}

/// One assistant thread per user. `contextKey` is fixed to `"general"` today
/// but kept distinct from `userId` alone so a future surface (e.g. a
/// per-request thread) can add a row without a schema change.
model AiConversation {
  id            String   @id @default(cuid())
  userId        String
  contextKey    String   @default("general")
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@unique([userId, contextKey])
}

/// Stores only the user's own text and the assistant's final answer text —
/// never raw tool-call arguments or tool result JSON, so a row never holds
/// more of another person's data than the answer already displayed to this
/// user.
model AiMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AiMessageRole
  content        String
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Observability for the AI assistant: latency, model, which tools ran, and
/// whether it succeeded. Deliberately has no content field — see
/// `redactAuditMetadata` for the same principle applied to the admin audit
/// log. `errorType` is a small closed set of coarse classes, never a raw
/// error message, which can otherwise embed request data.
model AiUsageLog {
  id               String   @id @default(cuid())
  userId           String?
  role             UserRole
  model            String
  latencyMs        Int
  toolNames        String[] @default([])
  success          Boolean
  errorType        String?
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * HOA amenities, bookings, issues, and reviews
 * Everything below is private to one official `hoa` community. There is no
 * public listing, no provider surface, and no neighborhood surface: every read
 * and write is scoped by `communityId` to an active HOA membership, an active
 * staff assignment for that HOA, or a Bundleen admin.
 * ══════════════════════════════════════════════════════════════════════════
 */

enum AmenityStatus {
  draft
  published
  archived
}

/// What residents are told *right now*, independent of publication. A
/// published amenity that is closed for repairs stays visible and explains
/// itself rather than vanishing from the catalog.
enum AmenityOperationalStatus {
  open
  closed
  maintenance
  temporarily_unavailable
}

enum AmenityType {
  pool
  clubhouse
  gym
  tennis_court
  badminton_court
  basketball_court
  meeting_room
  barbecue_area
  playground
  park
  other
}

enum AmenityClosureKind {
  blackout
  maintenance
  holiday
  private_event
}

/// Explicit booking lifecycle. `pending_approval` and `confirmed` are the two
/// states that hold capacity; every other state releases it.
enum AmenityBookingStatus {
  pending_approval
  confirmed
  declined
  cancelled_by_resident
  cancelled_by_manager
  completed
  no_show
}

enum AmenityBookingEventType {
  requested
  confirmed
  approved
  declined
  cancelled_by_resident
  cancelled_by_manager
  rescheduled
  completed
  no_show
  reminder_scheduled
  reminder_cancelled
}

enum AmenityIssueCategory {
  damage
  cleanliness
  safety
  access
  equipment
  reservation_conflict
  noise
  other
}

enum AmenityIssuePriority {
  low
  normal
  high
  urgent
}

enum AmenityIssueStatus {
  new
  acknowledged
  investigating
  waiting_on_resident
  resolved
  closed
}

/// `internal_note` is never serialized by a resident-facing reader. The
/// distinction is a column rather than a separate table so a manager reading
/// one thread sees a single ordered conversation.
enum AmenityIssueMessageKind {
  resident_message
  manager_reply
  internal_note
}

/// What a stored file is for. Visibility follows the purpose, so an issue
/// photo can never be served under gallery rules.
enum MediaPurpose {
  amenity_gallery
  amenity_review
  amenity_issue
}

enum MediaStatus {
  active
  removed
}

enum AmenityReviewStatus {
  published
  removed
}

/// One shared space in one HOA.
///
/// `bookingRequired = false` means a common area with hours and rules but no
/// calendar: residents read status, hours, and reviews and report issues, and
/// no booking row can ever be created against it.
model Amenity {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  name          String
  type          AmenityType
  description   String?
  /// Short bounded highlights such as `Floodlit`, `Towels provided`.
  features      String[]    @default([])
  /// Human location inside the HOA, e.g. `Behind the clubhouse`. Never an
  /// access code and never a coordinate.
  locationLabel String?

  rules               String?
  permittedUses       String?
  ageRestriction      String?
  guestPolicy         String?
  cancellationPolicy  String?
  /// Where to turn when something goes wrong. Resident-visible.
  contactInstructions String?

  status            AmenityStatus            @default(draft)
  operationalStatus AmenityOperationalStatus @default(open)
  /// Resident-visible explanation for a non-`open` status.
  operationalNote   String?
  /// Expected reopening, shown with the closure reason.
  reopensAt         DateTime?

  bookingRequired Boolean @default(false)

  // ── Booking policy ────────────────────────────────────────────────────
  // Every value here is snapshotted onto a booking at creation time, so a
  // later rule change cannot silently rewrite a reservation a resident is
  // already holding.
  slotMinutes                  Int     @default(60)
  minDurationMinutes           Int     @default(60)
  maxDurationMinutes           Int     @default(120)
  /// Cleanup/turnaround time reserved after each booking. Blocks the resource
  /// but is never shown to the resident as part of their reservation.
  bufferMinutes                Int     @default(0)
  maxPartySize                 Int     @default(1)
  /// How far ahead residents may book.
  advanceDays                  Int     @default(14)
  minNoticeMinutes             Int     @default(0)
  /// Residents may cancel until this many minutes before the start.
  cancellationCutoffMinutes    Int     @default(120)
  /// Concurrent upcoming reservations one resident may hold.
  maxActiveBookingsPerResident Int     @default(2)
  /// Same limit applied across everyone in one HOA unit; null disables it.
  maxActiveBookingsPerUnit     Int?
  approvalRequired             Boolean @default(false)

  /// Chosen from this amenity's own gallery. Enforced by a trigger, since a
  /// foreign key alone cannot say "and it must belong to this amenity".
  coverMediaId String?     @unique
  coverMedia   MediaAsset? @relation("AmenityCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  /// Transactionally maintained with every published review write. Never
  /// recomputed lazily, and never trusted from a client.
  ratingCount Int @default(0)
  ratingSum   Int @default(0)

  createdByUserId String
  createdBy       User   @relation("AmenityCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  resources AmenityResource[]
  hours     AmenityHours[]
  closures  AmenityClosure[]
  bookings  AmenityBooking[]
  issues    AmenityIssue[]
  reviews   AmenityReview[]
  media     MediaAsset[]      @relation("AmenityGallery")

  @@unique([communityId, name])
  @@index([communityId, status, name])
  @@index([communityId, status, type])
}

/// One independently bookable unit of an amenity: `Court 1`, `Court 2`.
///
/// Capacity is modelled as rows rather than a number because that is what
/// makes overbooking a database guarantee: every booking holds exactly one
/// resource, and a GiST exclusion constraint forbids two live bookings from
/// overlapping on the same resource. An exclusive room simply has one row.
model AmenityResource {
  id        String  @id @default(cuid())
  amenityId String
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  label    String
  position Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings AmenityBooking[]

  @@unique([amenityId, label])
  @@index([amenityId, active, position])
}

/// One opening period on one weekday, in the HOA's IANA timezone.
///
/// Minutes from local midnight. `closesMinute` may exceed 1440 to express an
/// overnight range (22:00–02:00 is `1320 -> 1560`), which keeps every window a
/// simple ordered pair instead of two rows that have to be stitched together.
model AmenityHours {
  id        String  @id @default(cuid())
  amenityId String
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  weekday      Weekday
  opensMinute  Int
  closesMinute Int

  @@unique([amenityId, weekday, opensMinute])
  @@index([amenityId, weekday])
}

/// A period when the amenity, or one of its resources, cannot be booked.
///
/// Either a one-off UTC range or a weekly recurring local-time window —
/// exactly one, CHECK-enforced.
model AmenityClosure {
  id        String  @id @default(cuid())
  amenityId String
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  kind AmenityClosureKind @default(blackout)

  startsAt DateTime?
  endsAt   DateTime?

  recurringWeekday     Weekday?
  recurringStartMinute Int?
  recurringEndMinute   Int?

  /// Shown to residents when true; an internal private-event block stays
  /// unlabelled but still removes the slot.
  residentVisible Boolean @default(true)
  reason          String?

  createdByUserId String?
  createdBy       User?   @relation("AmenityClosureCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([amenityId, startsAt, endsAt])
  @@index([amenityId, recurringWeekday])
}

/// One resident reservation of one resource for one period.
///
/// `blockStartsAt`/`blockEndsAt` widen the resident-facing range by the
/// buffer in force when the booking was made, and are the range the exclusion
/// constraint compares. Storing both means a later buffer change cannot move
/// an existing reservation's footprint.
model AmenityBooking {
  id          String          @id @default(cuid())
  /// Denormalized from the amenity so every tenant-scoped read and index is
  /// one table away from the HOA, never a join the caller might forget.
  communityId String
  community   Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  amenityId   String
  amenity     Amenity         @relation(fields: [amenityId], references: [id], onDelete: Restrict)
  resourceId  String
  resource    AmenityResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  userId String
  user   User           @relation("AmenityBookingResident", fields: [userId], references: [id], onDelete: Restrict)
  /// The HOA home the resident occupied when booking. Kept for per-unit limits
  /// and manager filtering; null for a manager-created operational block.
  unitId String?
  unit   CommunityUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  /// Short human reference for the confirmation email and the front desk. The
  /// opaque `id` remains the only thing any API accepts.
  reference String @unique

  startsAt      DateTime
  endsAt        DateTime
  /// Exclusion-constraint range: `startsAt` .. `endsAt + bufferMinutes`.
  blockStartsAt DateTime
  blockEndsAt   DateTime

  partySize      Int                  @default(1)
  status         AmenityBookingStatus
  /// IANA zone in force at creation, so the booking renders identically
  /// forever even if the HOA later corrects its timezone.
  timezone       String
  /// Frozen copy of the amenity policy this booking was accepted under.
  policySnapshot Json

  /// Resident-supplied note. Never included in an outbox payload.
  residentNote String?

  /// True when the amenity required approval at creation.
  approvalRequired Boolean   @default(false)
  approvedByUserId String?
  approvedBy       User?     @relation("AmenityBookingApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?

  cancelledByUserId  String?
  cancelledBy        User?     @relation("AmenityBookingCanceller", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancelledAt        DateTime?
  cancellationReason String?

  /// Set when a manager creates a closure/maintenance block rather than a
  /// resident reservation. Such a row holds capacity and sends no reminder.
  isManagerBlock Boolean @default(false)

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events  AmenityBookingEvent[]
  issues  AmenityIssue[]
  reviews AmenityReview[]

  @@index([amenityId, startsAt])
  @@index([communityId, status, startsAt])
  @@index([userId, startsAt])
  @@index([resourceId, blockStartsAt])
  @@index([status, startsAt])
}

/// Append-only history of what happened to one booking.
model AmenityBookingEvent {
  id        String         @id @default(cuid())
  bookingId String
  booking   AmenityBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type        AmenityBookingEventType
  actorUserId String?
  actor       User?                   @relation("AmenityBookingEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Short operational summary. Never a resident note or an access code.
  note        String?

  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

/// A resident-reported problem with an amenity, routed to that HOA's manager.
///
/// Deliberately *not* a `SupportTicket`: this never reaches the Bundleen
/// support queue, the global admin CRM, or the AI support context.
model AmenityIssue {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  amenityId   String
  amenity     Amenity   @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  reporterUserId String
  reporter       User   @relation("AmenityIssueReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)

  bookingId String?
  booking   AmenityBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  reference String               @unique
  category  AmenityIssueCategory
  priority  AmenityIssuePriority @default(normal)
  status    AmenityIssueStatus   @default(new)

  subject     String
  description String

  assignedToUserId String?
  assignedTo       User?   @relation("AmenityIssueAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  /// Manager's closing summary. Resident-visible by design.
  resolutionSummary String?
  resolvedAt        DateTime?
  closedAt          DateTime?
  /// Set when the reporter withdrew it themselves.
  withdrawnAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AmenityIssueMessage[]
  events   AmenityIssueEvent[]
  media    MediaAsset[]          @relation("AmenityIssueMedia")

  @@index([communityId, status, createdAt])
  @@index([amenityId, status])
  @@index([reporterUserId, createdAt])
  @@index([assignedToUserId, status])
}

model AmenityIssueMessage {
  id      String       @id @default(cuid())
  issueId String
  issue   AmenityIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User   @relation("AmenityIssueMessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  kind AmenityIssueMessageKind
  body String

  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
  @@index([issueId, kind])
}

model AmenityIssueEvent {
  id      String       @id @default(cuid())
  issueId String
  issue   AmenityIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  /// Short closed vocabulary such as `created`, `acknowledged`, `assigned`.
  type        String
  actorUserId String?
  actor       User?   @relation("AmenityIssueEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  fromStatus AmenityIssueStatus?
  toStatus   AmenityIssueStatus?

  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
}

/// A resident's rating of an amenity in their own HOA.
///
/// Eligibility is documented in `lib/server/amenity-reviews.ts`: a booking-
/// required amenity is reviewable only after a completed booking (one review
/// per completed booking); a non-bookable common area is reviewable by any
/// active resident, at most once.
model AmenityReview {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  amenityId   String
  amenity     Amenity   @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User   @relation("AmenityReviewAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  /// Set for a booking-backed review; drives the "verified booking" badge and
  /// the one-review-per-completed-booking rule.
  bookingId String?         @unique
  booking   AmenityBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  /// 1..5, CHECK-bounded.
  rating  Int
  comment String

  status   AmenityReviewStatus @default(published)
  /// Set on the first edit, so "Edited" is displayed honestly.
  editedAt DateTime?

  moderatedByUserId String?
  moderatedBy       User?     @relation("AmenityReviewModerator", fields: [moderatedByUserId], references: [id], onDelete: SetNull)
  moderationReason  String?
  moderatedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  response AmenityReviewResponse?
  media    MediaAsset[]           @relation("AmenityReviewMedia")

  @@index([amenityId, status, createdAt])
  @@index([amenityId, status, rating])
  @@index([authorUserId, createdAt])
}

/// At most one manager reply per review, always labelled as the manager's.
/// Managers may respond; they may never edit or delete the resident's words.
model AmenityReviewResponse {
  id       String        @id @default(cuid())
  reviewId String        @unique
  review   AmenityReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  responderUserId String
  responder       User   @relation("AmenityReviewResponder", fields: [responderUserId], references: [id], onDelete: Restrict)

  body String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One stored image, owned by exactly one amenity gallery, review, or issue
/// (CHECK-enforced).
///
/// `storageUrl` is server-only and is never serialized into an API response:
/// bytes reach a browser through `/api/hoa/amenities/media/[mediaId]`, which
/// re-checks authorization on every request. No storage credential is stored.
model MediaAsset {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  purpose MediaPurpose

  uploaderUserId String
  uploader       User   @relation("MediaUploader", fields: [uploaderUserId], references: [id], onDelete: Restrict)

  amenityId String?
  amenity   Amenity?       @relation("AmenityGallery", fields: [amenityId], references: [id], onDelete: Cascade)
  reviewId  String?
  review    AmenityReview? @relation("AmenityReviewMedia", fields: [reviewId], references: [id], onDelete: Cascade)
  issueId   String?
  issue     AmenityIssue?  @relation("AmenityIssueMedia", fields: [issueId], references: [id], onDelete: Cascade)

  /// Blob pathname, used for deletion and ownership checks.
  storagePath String @unique
  /// Blob read URL. Server-only; see the model comment.
  storageUrl  String

  contentType String
  byteSize    Int
  width       Int?
  height      Int?
  /// SHA-256 of the stored (re-encoded) bytes, for dedupe and integrity.
  checksum    String

  /// Gallery ordering. Null for review and issue attachments.
  position Int?

  status            MediaStatus @default(active)
  deletedAt         DateTime?
  /// Set when a Bundleen admin removed it under the moderation policy.
  moderatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coverOf Amenity? @relation("AmenityCover")

  @@index([amenityId, status, position])
  @@index([reviewId, status])
  @@index([issueId, status])
  @@index([communityId, purpose, createdAt])
}
